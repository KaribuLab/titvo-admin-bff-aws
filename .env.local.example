# Copy to .env.local and adjust if needed. Read by src/local-server.ts and,
# in turn, by every module that calls process.env at init time
# (app.module.ts, config.module.ts, session.module.ts, user.module.ts,
# crypto.module.ts, auth.module.ts).
#
# These values must match whatever docker-compose.local.yml + scripts/local-seed.mjs
# actually created — see docs/local-development.md.

PORT=3001

AWS_STAGE=localstack
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

USER_TABLE_NAME=user
SESSION_TABLE_NAME=session
PARAMETER_TABLE_NAME=tvo-security-scan-parameter-prod
REPOSITORY_TABLE_NAME=repository
TASK_TABLE_NAME=task
APIKEY_TABLE_NAME=apikey

ENCRYPTION_KEY_NAME=/tvo/local/aes_secret
JWT_SECRET_NAME=/tvo/local/jwt_secret

# Trigger-a-scan feature: titvo-task-trigger-aws's base URL. Not reachable
# from this local/LocalStack environment (it's a real deployed API Gateway,
# not something LocalStack mocks) — set to a placeholder so the local
# server doesn't crash on an undefined base URL; exercising the actual
# `/run-scan` call requires a real deployed stack.
TASK_TRIGGER_API_URL=https://example.invalid/v1

LOG_LEVEL=debug
