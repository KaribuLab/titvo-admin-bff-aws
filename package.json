{
  "name": "tvo-admin-bff",
  "version": "0.1.0",
  "main": "main.js",
  "ts-standard": {
    "ignore": [
      "test",
      "vite.config.ts"
    ]
  },
  "scripts": {
    "clean": "rimraf dist build",
    "lint": "ts-standard | snazzy",
    "build": "npm run clean && rspack build",
    "test": "vitest run",
    "dev": "vite-node -c vite-node.config.ts src/local-server.ts",
    "local:up": "docker compose -f docker-compose.local.yml up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:seed": "node scripts/local-seed.mjs"
  },
  "keywords": [
    "AWS",
    "Nest"
  ],
  "author": "Titvo",
  "license": "Apache-2.0",
  "devDependencies": {
    "@rspack/cli": "1.2.5",
    "@rspack/core": "1.2.5",
    "@swc/core": "^1.16.0",
    "@types/aws-lambda": "8.10.145",
    "@types/jest": "29.5.14",
    "@types/node": "22.5.4",
    "rimraf": "^6.1.3",
    "snazzy": "9.0.0",
    "ts-lib": "0.0.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "ts-standard": "12.0.2",
    "typescript": "5.5.4",
    "unplugin-swc": "^1.5.11",
    "vite-node": "^1.2.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-batch": "3.726.1",
    "@aws-sdk/client-dynamodb": "3.670.0",
    "@aws-sdk/client-lambda": "3.682.0",
    "@aws-sdk/client-s3": "3.665.0",
    "@aws-sdk/client-secrets-manager": "^3.777.0",
    "@aws-sdk/client-sfn": "3.679.0",
    "@aws-sdk/client-ssm": "3.670.0",
    "@aws-sdk/lib-dynamodb": "3.670.0",
    "@nestjs/axios": "3.1.1",
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@titvo/auth": "file:auth",
    "@titvo/aws": "file:lib/aws",
    "@titvo/shared": "file:shared",
    "axios": "1.7.7",
    "bcryptjs": "^2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dayjs": "1.11.13",
    "fast-xml-parser": "4.5.0",
    "nestjs-pino": "4.3.0",
    "pino": "9.6.0",
    "rxjs": "7.8.1"
  }
}
